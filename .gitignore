variants/v3-ebpf-ring/**/*.skel.h
variants/v3-ebpf-ring/build/
variants/v3.2-ebpf-core/*.skel.h
variants/v3.2-ebpf-core/**/*.skel.h
variants/v3.2-ebpf-core/build/
