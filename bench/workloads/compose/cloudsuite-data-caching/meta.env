# CloudSuite data-caching (Tier-B, C32/C33): memcached server under twitter-
# dataset load. Profiled = the `server` service; `load-client` follows the
# `load*` convention (unprofiled, host third).
COMPOSE_FILES="compose.yml"
ANCHOR_SERVICE="server"
READY_TIMEOUT=120
SETUP_HINT="bench/setup/setup-cloudsuite-workload.sh"
