# DeathStarBench social-network (Tier-C, C32/C33): ~28-service microservice
# app driven by wrk2. COMPOSE_FILES points into the installer-provisioned
# clone (override with INTP_DSB_ROOT); the harness-generated override parents
# ALL services under the profiled cgroup, so the fingerprint covers the whole
# microservice tree. Load (graph init + wrk2) is host-side via load.sh, pinned
# to the host third.
COMPOSE_FILES="${INTP_DSB_ROOT:-/opt/DeathStarBench}/socialNetwork/docker-compose.yml"
ANCHOR_SERVICE="nginx-thrift"
READY_TIMEOUT=240
SETUP_HINT="bench/setup/setup-dsb-workload.sh"
