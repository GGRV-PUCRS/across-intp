# CloudSuite web-search (Tier-B, C32/C33): Apache Solr index node under Faban
# client load. Profiled = the `server` service; `load-client` follows the
# `load*` convention (unprofiled, host third). The index dataset lives in the
# external volume `intp-cs-websearch-index`, provisioned ONCE by the installer
# (it survives the per-rep `down -v`). Solr heap is sized via SOLR_HEAP in this
# dir's .env (written by the installer; 12g testbed-grade, 4g dev-smoke).
COMPOSE_FILES="compose.yml"
ANCHOR_SERVICE="server"
READY_TIMEOUT=300
SETUP_HINT="bench/setup/setup-cloudsuite-workload.sh"
